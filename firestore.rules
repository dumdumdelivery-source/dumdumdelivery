rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == "admin"
      );
    }

    // ── Super Admin: Locations, Areas & Shops ──
    match /locations/{locationId} {
      allow read: if true;
      allow write: if isAuthenticated() || isAdmin();
    }

    match /areas/{areaId} {
      allow read: if true;
      allow write: if isAuthenticated() || isAdmin();
    }

    match /shops/{shopId} {
      allow read: if true;
      allow write: if isAuthenticated() || isAdmin();
    }

    // ── Stores ──
    // Anyone can read active stores. Admin only can create, update, or delete.
    match /stores/{storeId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if isAdmin();
    }

    // ── Products ──
    // Anyone can read active products. Admin only can create, update, or delete.
    match /products/{productId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if isAdmin();
    }

    // ── Users ──
    // Users can read and write only their own profile.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isAdmin();
    }

    // ── Orders ──
    // Customers can create an order with pending status, and read only their own orders.
    // Customers CANNOT modify order payment status, order status, or totals after order is created.
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );

      // Customer can create an order only for themselves with pending status
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.orderStatus == "pending" &&
        request.resource.data.paymentStatus == "pending" &&
        request.resource.data.subtotal is number &&
        request.resource.data.total is number &&
        request.resource.data.items is list;

      // Customers CANNOT update or delete orders once created
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
